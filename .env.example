# =============================================================================
# ملف الـ Environment Variables المطلوبة على Vercel
# =============================================================================
# انسخ هذه المتغيرات وضعها في:
# Vercel Dashboard → Project → Settings → Environment Variables

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Authentication ────────────────────────────────────────────────────────────
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=your-secure-password-here
APP_JWT_SECRET=your-random-secret-minimum-32-chars

# =============================================================================
# القيم الفعلية موجودة في ملف .env.local على جهازك (لا ترفعه على GitHub)
# =============================================================================
